# Environment Variables Template
# Copy this file to .env and fill in your actual values
# IMPORTANT: .env should NEVER be committed to version control

# Finnhub API Configuration
FINNHUB_API_KEY=your_finnhub_api_key_here
FINNHUB_BASE_URL=https://finnhub.io/api/v1/quote
FINNHUB_SYMBOLS=AAPL,MSFT,TSLA,GOOGL,AMZN

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_TOPIC=stock-quotes
KAFKA_AUTO_OFFSET_RESET=earliest

# MinIO Configuration
MINIO_ENDPOINT=http://localhost:9000
MINIO_ENDPOINT_DOCKER=http://minio:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123
MINIO_BUCKET=bronze-transactions

# Snowflake Configuration
SNOWFLAKE_USER=your_snowflake_user
SNOWFLAKE_PASSWORD=your_snowflake_password
SNOWFLAKE_ACCOUNT=your_snowflake_account.region.cloud_provider
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=STOCKS_MDS
SNOWFLAKE_SCHEMA=COMMON
SNOWFLAKE_TABLE=bronze_stock_quotes_raw

# Airflow Configuration
AIRFLOW_HOME=/airflow
AIRFLOW__CORE__DAGS_FOLDER=/airflow/dags
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__UNIT_TEST_MODE=False
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql://airflow:airflow@postgres:5432/airflow

# Database Configuration
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# Python Configuration
PYTHONUNBUFFERED=1

# Local Development Paths
LOCAL_DIR=/tmp/minio_downloads
